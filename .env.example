# Exemplo de variáveis de ambiente (arquivo: .env.example)
# ATENÇÃO: Este arquivo é um exemplo. NÃO commit arquivos com segredos reais.

# Database (usado pelo Postgres container)
DB_NAME=clickid
DB_USER=clickid
DB_PASSWORD=coto123
DB_HOST=db
DB_PORT=5432

# Django env (usado pelo container web)
DJANGO_SECRET_KEY=coloque_uma_chave_segura_aqui
DJANGO_ALLOWED_HOSTS=example.com,localhost
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=felipe@gmail.com
DJANGO_SUPERUSER_PASSWORD=flexa8000

# Redis & Celery (opcional local)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage (desabilitado por padrão)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=clickid-media
AWS_S3_REGION_NAME=us-east-1

# CORS (frontends permitidos)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Let's Encrypt (used by certbot service)
# Comma-separated domains (e.g. example.com,www.example.com)
LETSENCRYPT_DOMAINS=example.com,www.example.com
# Contact email for Let's Encrypt notices and recovery
LETSENCRYPT_EMAIL=admin@example.com
