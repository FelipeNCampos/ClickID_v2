# Exemplo de `.env.prod` — NÃO commitar este arquivo com segredos reais
# Copie para `.env.prod` e edite os valores sensíveis em produção

# Postgres (usado pelo serviço Postgres no Docker Compose)
DB_NAME=clickid
DB_USER=clickid
DB_PASSWORD=coto123
DB_HOST=db
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=cole_uma_chave_secreta_aqui
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=felipe@gmail.com
DJANGO_SUPERUSER_PASSWORD=flexa8000

# Redis (opcional)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=clickid-media
AWS_S3_REGION_NAME=us-east-1

# Observações:
# - Substitua `example.com` por seu domínio real.
# - Mantenha este arquivo fora do controle de versão.
